# CareerNexaa - Apache Configuration & SEO URL Rewrites
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security: Block sensitive files (.sql, .git, .env, .env.example)
    RewriteRule ^(\.git|\.env|\.env\.example|.*\.sql|config/database\.php) - [F,L]
</IfModule>

# Block access to hidden files and database dumps even if mod_rewrite is disabled
<FilesMatch "^(\.env|\.git|.*\.sql)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>

    # Dynamic Real-Time XML Sitemap Engine (Googlebot / Bingbot)
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Article Clean URL: /article/sample-slug
    RewriteRule ^article/([a-zA-Z0-9_-]+)/?$ article.php?slug=$1 [QSA,L]

    # Category Clean URL: /category/sample-slug
    RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ categories.php?slug=$1 [QSA,L]

    # Tag Clean URL: /tag/sample-slug
    RewriteRule ^tag/([a-zA-Z0-9_-]+)/?$ tag.php?slug=$1 [QSA,L]

    # Page Clean URL: /page/sample-slug
    RewriteRule ^page/([a-zA-Z0-9_-]+)/?$ page.php?slug=$1 [QSA,L]

    # Clean sections & filters paths
    RewriteRule ^vlogs/?$ articles.php?vlogs=1 [QSA,L]
    RewriteRule ^vlog/?$ articles.php?vlogs=1 [QSA,L]
    RewriteRule ^trending/?$ articles.php?trending=1 [QSA,L]
    RewriteRule ^jobs/?$ articles.php?jobs=1 [QSA,L]
    RewriteRule ^search/?$ search.php [QSA,L]
    RewriteRule ^articles/?$ articles.php [QSA,L]
    RewriteRule ^categories/?$ categories.php [QSA,L]
    RewriteRule ^about/?$ about.php [L]
    RewriteRule ^contact/?$ contact.php [L]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L]
    RewriteRule ^cookie-policy/?$ cookie-policy.php [L]
    RewriteRule ^cookies/?$ cookie-policy.php [L]
    RewriteRule ^terms/?$ terms.php [L]
    RewriteRule ^disclaimer/?$ disclaimer.php [L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 404.php

# Disable Directory Browsing
Options -Indexes

# Security & SEO Crawl Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
</IfModule>

# Production Performance: Gzip Compression (Speed & Core Web Vitals)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Production Performance: Leverage Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
