# ==============================================================================
# CareerPulse Job Portal - Production Environment Configuration (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Rename or copy this file to ".env" on your live web server (cPanel / VPS / Cloud).
# 2. Update the values below to match your live hosting settings.
# 3. Keep your .env file secret and NEVER commit real passwords to public Git repos.
# ==============================================================================

# Application Environment: 'production' for live website, 'development' for local testing
APP_ENV=production

# Live Website URL (No trailing slash)
# Example: https://example.com OR https://jobs.example.com
# If left empty, the site will automatically detect the protocol and domain.
APP_URL=https://example.com

# ------------------------------------------------------------------------------
# Live Database Settings (from cPanel MySQL Databases or Cloud DB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=cpaneluser_jobportal
DB_USER=cpaneluser_jobuser
DB_PASS=YourStrongPasswordHere!@#
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# Gmail SMTP / Email Server Configuration (PHPMailer)
# ------------------------------------------------------------------------------
# NOTE: For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (Requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_SECURE=tls
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="CareerPulse Admin"

